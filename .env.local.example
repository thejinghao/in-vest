# Copy this file to .env.local and fill in real values for local dev.
# On Vercel, the Supabase Marketplace integration sets the Supabase vars
# automatically, and AI_GATEWAY_API_KEY is provided by the platform.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Vercel AI Gateway (Claude) ---
AI_GATEWAY_API_KEY=

# --- Schwab API (manual; needs developer.schwab.com approval) ---
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://localhost:3000/api/schwab/callback
